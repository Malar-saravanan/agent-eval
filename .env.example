# Azure OpenAI (or an Azure-fronted gateway) credentials. Copy to .env and fill in.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Deployment name for each model in config/models.yaml (deployment_env). Add one per model.
MODEL1_DEPLOYMENT=gpt-4.1-mini

# Optional: model used as the LLM judge (defaults to the first model in config/models.yaml)
# JUDGE_MODEL=gpt-4.1-mini

# Optional: host port for the UI/API (default 3000); max concurrent trials (default 4)
# API_PORT=3000
# CONCURRENCY=4
